# Exemple : adapter User et les chemins si le compte Linux n'est pas tom.
[Unit]
Description=Odyssée - simulation hydroponique de laboratoire
After=network.target

[Service]
Type=simple
User=tom
WorkingDirectory=/home/tom/Projet_Odyssee
ExecStart=/usr/bin/python3 -u /home/tom/Projet_Odyssee/labs/hydroponie_sim/server.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
